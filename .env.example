# --- Zerodha Kite Connect (developer console) ---
KITE_API_KEY=
KITE_API_SECRET=

# --- Dashboard login (use a long random string) ---
DASHBOARD_PASSWORD=

# --- paper = simulated fills on live ticks (default). live = real orders. ---
TRADING_MODE=paper

# Railway: mount a Volume at /data so the daily lock survives restarts
DATA_DIR=/data

# --- Risk (all enforced in code, not in the UI) ---
CAPITAL=100000
MAX_DAILY_LOSS_PCT=1.5
RISK_PER_TRADE_PCT=0.5
MAX_OPEN_POSITIONS=2
MAX_NOTIONAL_MULT=1.0

# --- Universe + strategy (opening range breakout, sample strategy) ---
WATCHLIST=RELIANCE,TCS,INFY
CANDLE_MINUTES=5
OR_START=09:15
OR_END=09:30
NO_NEW_ENTRY=14:30
SQUARE_OFF=15:10
MAX_STOP_PCT=1.0
TARGET_R=2.0
